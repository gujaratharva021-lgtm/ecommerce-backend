# Server
PORT=8080
GIN_MODE=debug

# Database (Docker Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce_db
DB_SSLMODE=disable

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRY_HOURS=72

# Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:19006

# Seller/invoice details shown on tax invoices. Leave unset until you have
# the real registered business details - invoices show "Not configured"
# for anything left blank rather than a fake placeholder.
SELLER_COMPANY_NAME=
SELLER_ADDRESS=
SELLER_GSTIN=
SELLER_CONTACT_NUMBER=
SELLER_EMAIL=
SELLER_STATE=
SELLER_STATE_CODE=
SELLER_FSSAI_NUMBER=
