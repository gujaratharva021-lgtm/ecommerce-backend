+// Online/offline toggle shown on the dashboard banner. Reflects the status
+// persisted on the backend (fetched on load) rather than a hardcoded value,
+// shows a spinner while loading/updating, and surfaces a retry on error.
+class _OnlineStatusToggle extends StatelessWidget {
+  final bool? isOnline;
+  final bool loading;
+  final bool updating;
+  final String? error;
+  final VoidCallback onTap;
+  final VoidCallback onRetry;
+
+  const _OnlineStatusToggle({
+    required this.isOnline,
+    required this.loading,
+    required this.updating,
+    required this.error,
+    required this.onTap,
+    required this.onRetry,
+  });
+
+  static const Color onlineGreen = Color(0xFF22C55E);
+
+  @override
+  Widget build(BuildContext context) {
+    if (loading) {
+      return Container(
+        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
+        decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(20)),
+        child: const Row(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            SizedBox(
+              width: 12,
+              height: 12,
+              child: CircularProgressIndicator(strokeWidth: 2),
+            ),
+            SizedBox(width: 8),
+            Text('Checking status…', style: TextStyle(fontSize: 12, fontWeight: FontWeight.w600)),
+          ],
+        ),
+      );
+    }
+
+    if (error != null && isOnline == null) {
+      return InkWell(
+        onTap: onRetry,
+        borderRadius: BorderRadius.circular(20),
+        child: Container(
+          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
+          decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(20)),
+          child: const Row(
+            mainAxisSize: MainAxisSize.min,
+            children: [
+              Icon(Icons.error_outline, color: Colors.redAccent, size: 14),
+              SizedBox(width: 6),
+              Text('Status unavailable · Retry', style: TextStyle(fontSize: 12, fontWeight: FontWeight.w600)),
+            ],
+          ),
+        ),
+      );
+    }
+
+    final online = isOnline == true;
+    return InkWell(
+      onTap: updating ? null : onTap,
+      borderRadius: BorderRadius.circular(20),
+      child: Container(
+        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
+        decoration: BoxDecoration(
+          color: Colors.white,
+          borderRadius: BorderRadius.circular(20),
+        ),
+        child: Row(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            if (updating)
+              const SizedBox(
+                width: 10,
+                height: 10,
+                child: CircularProgressIndicator(strokeWidth: 2),
+              )
+            else
+              Icon(Icons.circle, color: online ? onlineGreen : Colors.grey, size: 10),
+            const SizedBox(width: 6),
+            Text(
+              online ? 'Online' : 'Offline',
+              style: const TextStyle(fontSize: 12, fontWeight: FontWeight.w600),
+            ),
+            const SizedBox(width: 6),
+            Switch(
+              value: online,
+              onChanged: updating ? null : (_) => onTap(),
+              activeColor: onlineGreen,
+              materialTapTargetSize: MaterialTapTargetSize.shrinkWrap,
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
